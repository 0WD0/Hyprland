<?xml version="1.0" encoding="UTF-8"?>
<protocol name="gtk_shell1">
  <interface name="gtk_shell1" version="5">
    <description summary="GTK-specific shell requests">
      Minimal server-side implementation of the GTK shell protocol.
    </description>

    <event name="capabilities">
      <arg name="capabilities" type="uint"/>
    </event>

    <request name="get_gtk_surface" since="3">
      <arg name="id" type="new_id" interface="gtk_surface1"/>
      <arg name="surface" type="object" interface="wl_surface"/>
    </request>

    <request name="set_startup_id">
      <arg name="startup_id" type="string" allow-null="true"/>
    </request>

    <request name="system_bell">
      <arg name="surface" type="object" interface="wl_surface" allow-null="true"/>
    </request>

    <request name="notify_launch" since="3">
      <arg name="startup_id" type="string"/>
    </request>
  </interface>

  <interface name="gtk_surface1" version="5">
    <description summary="GTK-specific per-surface requests">
      Minimal server-side implementation used for focus/present requests.
    </description>

    <request name="set_dbus_properties">
      <arg name="application_id" type="string" allow-null="true"/>
      <arg name="app_menu_path" type="string" allow-null="true"/>
      <arg name="menubar_path" type="string" allow-null="true"/>
      <arg name="window_object_path" type="string" allow-null="true"/>
      <arg name="application_object_path" type="string" allow-null="true"/>
      <arg name="unique_bus_name" type="string" allow-null="true"/>
    </request>

    <request name="set_modal"/>
    <request name="unset_modal"/>

    <request name="present">
      <arg name="time" type="uint"/>
    </request>

    <request name="request_focus" since="3">
      <arg name="startup_id" type="string" allow-null="true"/>
    </request>

    <request name="release" type="destructor" since="4"/>

    <request name="titlebar_gesture" since="5">
      <arg name="gesture" type="uint"/>
      <arg name="seat" type="object" interface="wl_seat"/>
      <arg name="serial" type="uint"/>
    </request>

    <event name="configure">
      <arg name="states" type="array"/>
    </event>

    <event name="configure_edges" since="2">
      <arg name="constraints" type="array"/>
    </event>
  </interface>
</protocol>
